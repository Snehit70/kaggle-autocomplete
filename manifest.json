{
  "manifest_version": 3,
  "name": "Kaggle Autocomplete",
  "version": "0.2.0",
  "description": "Colab-style as-you-type autocompletion for Kaggle notebooks (auto-opens JupyterLab's completer).",
  "permissions": ["storage"],
  "action": {
    "default_title": "Kaggle Autocomplete",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://*.jupyter-proxy.kaggle.net/*"],
      "js": ["shared.js", "content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
